<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ===========================================================
       Определяем ROS 2 Control-блок для гусеничной платформы Т-21
       Параметр prefix (по-умолчанию пустой) позволяет запускать
       несколько роботов в одном графе.
  ================================================================= -->
  <xacro:unless value="$(arg use_sim_time)">
  <xacro:macro name="t21_ros2_control" params="name prefix">

    <ros2_control name="${name}_hw" type="system">
      <!-- аппаратный плагин -->
      <hardware>
        <plugin>t21_hardware/T21TrackedHardware</plugin>
        <!-- при необходимости можно добавить <param …/> -->
      </hardware>

      <!-- виртуальный сустав линейной скорости -->
      <joint name="${prefix}wheel_left_joint">
        <command_interface name="velocity"/>
        <state_interface   name="velocity"/>
        <state_interface name="position"/>
      </joint>

      <!-- виртуальный сустав угловой скорости -->
      <joint name="${prefix}wheel_right_joint">
        <command_interface name="velocity"/>
        <state_interface   name="velocity"/>
        <state_interface name="position"/>
      </joint>

      <!-- реальный сустав флиппера / стрелы -->
      <joint name="${prefix}geom_joint">
        <command_interface name="position"/>
        <state_interface   name="position"/>
      </joint>
    </ros2_control>

  </xacro:macro>
    <!-- Вызываем макрос, передавая имя и префикс -->
    <xacro:t21_ros2_control name="t21" prefix="$(arg prefix)"/>
  </xacro:unless>
  <xacro:if value="$(arg use_sim_time)">
    <!-- ===========================================================
       Определяем ROS 2 Control-блок для гусеничной платформы Т-21
       Параметр prefix (по-умолчанию пустой) позволяет запускать
       несколько роботов в одном графе.
    ================================================================= -->
    <ros2_control name="GazeboSystem" type="system">
      <!-- аппаратный плагин -->
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        <!-- при необходимости можно добавить <param …/> -->
      </hardware>

      <!-- виртуальный сустав линейной скорости -->
      <joint name="wheel_left_joint">
        <command_interface name="velocity"/>
        <state_interface   name="velocity"/>
        <state_interface name="position"/>
      </joint>

      <!-- виртуальный сустав угловой скорости -->
      <joint name="wheel_right_joint">
        <command_interface name="velocity"/>
        <state_interface   name="velocity"/>
        <state_interface name="position"/>
      </joint>

      <!--реальный сустав флиппера / стрелы -->
      <joint name="fliper_joint">
        <command_interface name="position"/>
        <state_interface   name="position"/>
      </joint>
    </ros2_control>

    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <parameters>$(find t21_sim)/config/my_controllers.yaml</parameters>
        </plugin>
        <!-- <updateRate>10</updateRate> -->
        <!-- <ros>
          <remapping>odom:=odom/unfiltered</remapping>
        </ros> -->
    </gazebo>
  </xacro:if>
</robot>
