<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <xacro:property name="lidar_translation" value="0.0036 -2.29E-05 0.095"/>

    <link name="lidar_link">
      <inertial>
        <mass value="1e-6"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="big_box_link"/>
      <child link="lidar_link"/>
      <origin xyz="${lidar_translation}" rpy="0 0 0"/>
    </joint>

  <!-- блок симуляции VLP-16-->
  <xacro:if value="$(arg use_sim_time)">
    <xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro"/>
    <xacro:VLP-16 
      parent="lidar_link" 
      name="velodyne" 
      topic="/velodyne_points" 
      organize_cloud="false" 
      hz="10" 
      lasers="16"
      samples="400" 
      collision_range="0.3" 
      min_range="0.1" 
      max_range="25.0" 
      noise="0.0"   
      min_angle="-${pi}" 
      max_angle="${pi}" 
      gpu="false">
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:VLP-16>
  </xacro:if>
</robot>