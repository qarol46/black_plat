  <?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tank_robot">
  <gazebo>
    <plugin name="diff_drive_controller_base" filename="libgazebo_ros_diff_drive.so">
      <num_wheel_pairs>4</num_wheel_pairs>
      <!-- Левая сторона -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>front_left_mid_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <left_joint>rear_left_mid_wheel_joint</left_joint>
      <!-- Правая сторона -->
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>front_right_mid_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <right_joint>rear_right_mid_wheel_joint</right_joint>

      <wheel_separation>0.6</wheel_separation>
      <wheel_diameter>0.3</wheel_diameter>
      <max_wheel_torque>2000</max_wheel_torque>
      <max_wheel_acceleration>10.0</max_wheel_acceleration>
      <!-- <odometry_frame>odom</odometry_frame> -->
      <robot_base_frame>chassis_link</robot_base_frame>
      <!-- <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf> -->
    </plugin>
  </gazebo>

  <!-- 9.2) Плагин для колёс флипперов (12 колёс) -->
  <gazebo>
    <plugin name="diff_drive_controller_flippers" filename="libgazebo_ros_diff_drive.so">
      <num_wheel_pairs>6</num_wheel_pairs>
      <!-- "Левая сторона" (в коде - часть флипперов) -->
      <left_joint>front_left_1_flipper_wheel_joint</left_joint>
      <left_joint>front_left_2_flipper_wheel_joint</left_joint>
      <left_joint>front_left_3_flipper_wheel_joint</left_joint>

      <left_joint>rear_left_1_flipper_wheel_joint</left_joint>
      <left_joint>rear_left_2_flipper_wheel_joint</left_joint>
      <left_joint>rear_left_3_flipper_wheel_joint</left_joint>

      <!-- "Правая сторона" (другая часть флипперов) -->
      <right_joint>front_right_1_flipper_wheel_joint</right_joint>
      <right_joint>front_right_2_flipper_wheel_joint</right_joint>
      <right_joint>front_right_3_flipper_wheel_joint</right_joint>

      <right_joint>rear_right_1_flipper_wheel_joint</right_joint>
      <right_joint>rear_right_2_flipper_wheel_joint</right_joint>
      <right_joint>rear_right_3_flipper_wheel_joint</right_joint>

      <wheel_separation>1.2</wheel_separation>
      <wheel_diameter>0.3</wheel_diameter>
      <max_wheel_torque>200</max_wheel_torque>
      <max_wheel_acceleration>10.0</max_wheel_acceleration>
       <robot_base_frame>chassis_link</robot_base_frame>
     <!-- <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf> -->
    </plugin>
  </gazebo>


  
</robot>