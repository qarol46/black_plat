<?xml version="1.0"?>
<robot name="tank_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ============================================= -->
  <!-- 1) МАТЕРИАЛЫ                                  -->
  <!-- ============================================= -->
  <!-- <material name="Gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material> -->
    <material name="Gray">
    <color rgba="0.0 0.0 1.0 1.0"/>
  </material>
  <material name="Blue">
    <color rgba="0.0 0.0 1.0 1.0"/>
  </material>

  <!-- ============================================= -->
  <!-- 2) МАКРОСЫ                                    -->
  <!--    - wheel_macro           Колесо базы       -->
  <!--    - flipper_base_macro    Основание флиппера-->
  <!--    - flippers_wheel_macro  Колёса на флиппере-->
  <!-- ============================================= -->

  <xacro:macro name="wheel_macro" params="
    wheel_name
    parent_link
    xyz:='0 0 0'
    rpy:='-1.57 1.57 0'
    radius:='0.1'
    length:='0.1'
    mass:='0.10'
    ixx:='0.01'
    iyy:='0.01'
    izz:='0.01'
    ixy:='0.0'
    ixz='0.0'
    iyz='0.0'
  ">
    <!-- Звено колеса -->
    <link name="${wheel_name}">
      <visual>
      <!-- <origin xyz="${xyz}" rpy="${rpy}"/> -->
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="Blue"/>
      </visual>
      <collision>
      <!-- <origin xyz="${xyz}" rpy="${rpy}"/> -->
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}" ixy="${ixy}" ixz="${ixz}" iyz="${iyz}"/>
      </inertial>
    </link>

    <!-- Джойнт колеса (ось вращения 0 0 1) -->
    <joint name="${wheel_name}_joint" type="continuous">
      <parent link="${parent_link}"/>
      <child link="${wheel_name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="0 0 1"/>
    </joint>

   <!-- -->
 <!-- <gazebo reference="${wheel_name}_collision">
  <surface>
    <friction>
      <ode>
        <mu>0.5</mu>
        <mu2>0.5</mu2>
        <fdir1>0 0 0</fdir1>
      </ode>
    </friction>
    <contact>
      <ode>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <ki>100.0</ki>
        <minDepth>0</minDepth>
        <maxContacts>1</maxContacts>
      </ode>
    </contact>
  </surface>
</gazebo>  -->


  </xacro:macro>

  <xacro:macro name="flipper_base_macro" params="
    wheel_name
    parent_link
    xyz:='0 0 0'
    rpy:='-1.57 0 0'
    radius:='0.05'
    length:='0.1'
    mass:='0.1'
    ixx:='0.00145833'
    iyy:='0.00145833'
    izz:='0.00125'
    ixy:='0.0'
    ixz:='0.0'
    iyz:='0.0'
  ">
    <!-- Звено основания флиппера -->
    <link name="${wheel_name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="Blue"/>
      </visual>
      <!-- (коллизию можно добавить, если нужно) -->
      <inertial>
        <mass value="${mass}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
        <inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}" ixy="${ixy}" ixz="${ixz}" iyz="${iyz}"/>
      </inertial>
    </link>

    <joint name="${wheel_name}_joint" type="continuous">
      <parent link="${parent_link}"/>
      <child link="${wheel_name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="flippers_wheel_macro" params="
    wheel_name
    parent_link
    xyz:='0 0 0'
    rpy:='0 0 0'
    radius:='0.1'
    length:='0.1'
    mass:='0.10'
    ixx:='0.01'
    iyy:='0.01'
    izz:='0.01'
    ixy:='0.0'
    ixz:='0.0'
    iyz:='0.0'
  ">
    <!-- Звено колеса флиппера -->
    <link name="${wheel_name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="Blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}" ixy="${ixy}" ixz="${ixz}" iyz="${iyz}"/>
      </inertial>
    </link>

    <joint name="${wheel_name}_joint" type="continuous">
      <parent link="${parent_link}"/>
      <child link="${wheel_name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <!-- ============================================= -->
  <!-- 3) КОРНЕВОЕ ЗВЕНО (base_link)                 -->
  <!-- ============================================= -->
  <!-- <link name="base_link"/> -->

  <!-- ============================================= -->
  <!-- 4) ШАССИ (chassis_link)                       -->
  <!-- ============================================= -->
  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.12"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.5" iyy="0.5" izz="0.5" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <!-- Фиксируем chassis_link к base_link -->
  <!-- <joint name="base_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
  </joint> -->

  <!-- ============================================= -->
  <!-- 5) ГУСЕНИЦЫ (визуальные треки слева/справа)   -->
  <!-- ============================================= -->
  <link name="left_track_link">
    <visual>
      <origin xyz="0 0.2 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.1 0.2"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  <joint name="chassis_left_track" type="fixed">
    <parent link="chassis_link"/>
    <child link="left_track_link"/>
  </joint>

  <link name="right_track_link">
    <visual>
      <origin xyz="0 -0.2 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.1 0.2"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  <joint name="chassis_right_track" type="fixed">
    <parent link="chassis_link"/>
    <child link="right_track_link"/>
  </joint>

  <!-- ============================================= -->
  <!-- 6) КОЛЕСА БАЗЫ (8 штук), вызываем wheel_macro -->
  <!-- ============================================= -->
  <xacro:wheel_macro wheel_name="front_left_wheel"     parent_link="chassis_link" xyz="0.25 0.2 0.0"/>
  <xacro:wheel_macro wheel_name="front_left_mid_wheel" parent_link="chassis_link" xyz="0.1 0.2 0.0"/>
  <xacro:wheel_macro wheel_name="front_right_wheel"    parent_link="chassis_link" xyz="0.25 -0.2 0.0"/>
  <xacro:wheel_macro wheel_name="front_right_mid_wheel" parent_link="chassis_link" xyz="0.1 -0.2 0.0"/>

  <xacro:wheel_macro wheel_name="right_mid_wheel" parent_link="chassis_link" xyz="0.0 -0.2 0.0"/>
  <xacro:wheel_macro wheel_name="left_mid_wheel" parent_link="chassis_link" xyz="0.0 0.2 0.0"/>


  <xacro:wheel_macro wheel_name="rear_left_wheel"      parent_link="chassis_link" xyz="-0.25 0.2 0.0"/>
  <xacro:wheel_macro wheel_name="rear_left_mid_wheel"  parent_link="chassis_link" xyz="-0.1 0.2 0.0"/>
  <xacro:wheel_macro wheel_name="rear_right_wheel"     parent_link="chassis_link" xyz="-0.25 -0.2 0.0"/>
  <xacro:wheel_macro wheel_name="rear_right_mid_wheel" parent_link="chassis_link" xyz="-0.1 -0.2 0.0"/>

  <!-- ============================================= -->
  <!-- 7) ОСНОВАНИЯ ФЛИППЕРОВ (4 штуки),             -->
  <!--    вызываем flipper_base_macro               -->
  <!-- ============================================= -->
  <xacro:flipper_base_macro wheel_name="front_left_flipper"  parent_link="chassis_link" xyz="0.25 0.3 0.0"/>
  <xacro:flipper_base_macro wheel_name="front_right_flipper" parent_link="chassis_link" xyz="0.25 -0.3 0.0"/>
  <xacro:flipper_base_macro wheel_name="rear_left_flipper"   parent_link="chassis_link" xyz="-0.25 0.3 0.0"/>
  <xacro:flipper_base_macro wheel_name="rear_right_flipper"  parent_link="chassis_link" xyz="-0.25 -0.3 0.0"/>

  <!-- ============================================= -->
  <!-- 8) ФЛИППЕРЫ - КОЛЁСА И ТРЕКИ (визуальные)      -->
  <!--    8.1) ЛЕВЫЙ ПЕРЕДНИЙ ФЛИППЕР                -->
  <!-- ============================================= -->
  <xacro:flippers_wheel_macro wheel_name="front_left_3_flipper_wheel" parent_link="front_left_flipper" xyz="0.31 0.0 0.0"/>
  <xacro:flippers_wheel_macro wheel_name="front_left_2_flipper_wheel" parent_link="front_left_flipper" xyz="0.1505 0.0 0.0"/>
  <xacro:flippers_wheel_macro wheel_name="front_left_1_flipper_wheel" parent_link="front_left_flipper" xyz="0.0 0.0 0.0"/>

  <link name="left_front_track_flipper_link">
    <visual>
      <origin xyz="0.1505 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.31 0.2 0.1"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  <joint name="flipper_box_front_left_joint" type="fixed">
    <parent link="front_left_flipper"/>
    <child link="left_front_track_flipper_link"/>
  </joint>

  <!-- 8.2) ПРАВЫЙ ПЕРЕДНИЙ ФЛИППЕР -->
  <xacro:flippers_wheel_macro wheel_name="front_right_3_flipper_wheel" parent_link="front_right_flipper" xyz="0.31 0.0 0.0"/>
  <xacro:flippers_wheel_macro wheel_name="front_right_2_flipper_wheel" parent_link="front_right_flipper" xyz="0.1505 0.0 0.0"/>
  <xacro:flippers_wheel_macro wheel_name="front_right_1_flipper_wheel" parent_link="front_right_flipper" xyz="0.0 0.0 0.0"/>

  <link name="right_front_track_flipper_link">
    <visual>
      <origin xyz="0.1505 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.31 0.2 0.1"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  <joint name="flipper_box_front_right_joint" type="fixed">
    <parent link="front_right_flipper"/>
    <child link="right_front_track_flipper_link"/>
  </joint>

  <!-- 8.3) ЛЕВЫЙ ЗАДНИЙ ФЛИППЕР -->
  <xacro:flippers_wheel_macro wheel_name="rear_left_3_flipper_wheel" parent_link="rear_left_flipper" xyz="-0.31 0.0 0.0"/>
  <xacro:flippers_wheel_macro wheel_name="rear_left_2_flipper_wheel" parent_link="rear_left_flipper" xyz="-0.1505 0.0 0.0"/>
  <xacro:flippers_wheel_macro wheel_name="rear_left_1_flipper_wheel" parent_link="rear_left_flipper" xyz="0.0 0.0 0.0"/>

  <link name="left_rear_track_flipper_link">
    <visual>
      <origin xyz="-0.1505 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.31 0.2 0.1"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  <joint name="flipper_box_rear_left_joint" type="fixed">
    <parent link="rear_left_flipper"/>
    <child link="left_rear_track_flipper_link"/>
  </joint>

  <!-- 8.4) ПРАВЫЙ ЗАДНИЙ ФЛИППЕР -->
  <xacro:flippers_wheel_macro wheel_name="rear_right_3_flipper_wheel" parent_link="rear_right_flipper" xyz="-0.31 0.0 0.0"/>
  <xacro:flippers_wheel_macro wheel_name="rear_right_2_flipper_wheel" parent_link="rear_right_flipper" xyz="-0.1505 0.0 0.0"/>
  <xacro:flippers_wheel_macro wheel_name="rear_right_1_flipper_wheel" parent_link="rear_right_flipper" xyz="0.0 0.0 0.0"/>

  <link name="right_rear_track_flipper_link">
    <visual>
      <origin xyz="-0.1505 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.31 0.2 0.1"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
  <joint name="flipper_box_rear_right_joint" type="fixed">
    <parent link="rear_right_flipper"/>
    <child link="right_rear_track_flipper_link"/>
  </joint>

<gazebo>

 <plugin name="trucked_vehicle_joint_state_pb" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>

        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>1000</update_rate>

      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_left_mid_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_left_mid_wheel_joint</joint_name>
      <joint_name>left_mid_wheel_joint</joint_name>

      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>front_right_mid_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <joint_name>rear_right_mid_wheel_joint</joint_name>
      <joint_name>right_mid_wheel_joint</joint_name>


      <joint_name>front_left_1_flipper_wheel_joint</joint_name>
      <joint_name>front_left_2_flipper_wheel_joint</joint_name>
      <joint_name>front_left_3_flipper_wheel_joint</joint_name>

      <joint_name>front_right_1_flipper_wheel_joint</joint_name>
      <joint_name>front_right_2_flipper_wheel_joint</joint_name>
      <joint_name>front_right_3_flipper_wheel_joint</joint_name>

      <joint_name>rear_left_1_flipper_wheel_joint</joint_name>
      <joint_name>rear_left_2_flipper_wheel_joint</joint_name>
      <joint_name>rear_left_3_flipper_wheel_joint</joint_name>

      <joint_name>rear_right_1_flipper_wheel_joint</joint_name>
      <joint_name>rear_right_2_flipper_wheel_joint</joint_name>
      <joint_name>rear_right_3_flipper_wheel_joint</joint_name>

    </plugin>
 </gazebo> 

  <gazebo>
    <plugin name="diff_drive_controller_base" filename="libgazebo_ros_diff_drive.so">
      <num_wheel_pairs>5</num_wheel_pairs>
      <!-- Левая сторона -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>front_left_mid_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <left_joint>rear_left_mid_wheel_joint</left_joint>
      <left_joint>left_mid_wheel_joint</left_joint>

      <!-- Правая сторона -->
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>front_right_mid_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <right_joint>rear_right_mid_wheel_joint</right_joint>
      <right_joint>right_mid_wheel_joint</right_joint>


      <wheel_separation>0.6</wheel_separation>
      <wheel_diameter>0.14</wheel_diameter>
      <max_wheel_torque>500</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>chassis_link</robot_base_frame>
       <publish_odom>true</publish_odom>
     <!-- <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf> -->
    </plugin>
  </gazebo>

  <!-- 9.2) Плагин для колёс флипперов (12 колёс) -->
  <gazebo>
    <plugin name="diff_drive_controller_flippers" filename="libgazebo_ros_diff_drive.so">
      <num_wheel_pairs>6</num_wheel_pairs>
      <!-- "Левая сторона" (в коде - часть флипперов) -->
      <left_joint>front_left_1_flipper_wheel_joint</left_joint>
      <left_joint>front_left_2_flipper_wheel_joint</left_joint>
      <left_joint>front_left_3_flipper_wheel_joint</left_joint>

      <left_joint>rear_left_1_flipper_wheel_joint</left_joint>
      <left_joint>rear_left_2_flipper_wheel_joint</left_joint>
      <left_joint>rear_left_3_flipper_wheel_joint</left_joint>

      <!-- "Правая сторона" (другая часть флипперов) -->
      <right_joint>front_right_1_flipper_wheel_joint</right_joint>
      <right_joint>front_right_2_flipper_wheel_joint</right_joint>
      <right_joint>front_right_3_flipper_wheel_joint</right_joint>

      <right_joint>rear_right_1_flipper_wheel_joint</right_joint>
      <right_joint>rear_right_2_flipper_wheel_joint</right_joint>
      <right_joint>rear_right_3_flipper_wheel_joint</right_joint>

      <wheel_separation>0.8</wheel_separation>
      <wheel_diameter>0.14</wheel_diameter>
      <max_wheel_torque>500</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      <!-- <odometry_frame>odom</odometry_frame>
      <robot_base_frame>chassis_link</robot_base_frame>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf> -->
    </plugin>
  </gazebo>

</robot>

