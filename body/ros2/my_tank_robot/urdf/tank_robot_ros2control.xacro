<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tank_robot">

  <!-- === Блок ROS2 Control (Аппаратный интерфейс) === -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <!-- Связка с Gazebo через GazeboSystem -->
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <!-- Колёса, управляющиеся по скорости (velocity) -->
